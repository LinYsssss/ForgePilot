APP_ENV=prod
SERVER_PORT=8080
DB_URL=jdbc:postgresql://postgres:5432/code_review
DB_USERNAME=code_review
DB_PASSWORD=change-me
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=guest
RABBITMQ_PASSWORD=guest
SANDBOX_SIGNING_SECRET=change-me-to-a-separate-long-random-string
SANDBOX_TOOL_IMAGE=replace-with-pinned-tool-image@sha256:replace-with-real-digest
JWT_SECRET=change-me-to-a-long-random-string
TOKEN_ENCRYPT_KEY=change-me-to-another-long-random-string
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=change-me-strong-password
SEED_ADMIN_NICKNAME=管理员
SEED_ADMIN_ROLE=ADMIN
REVIEW_INLINE=false
LLM_BASE_URL=https://token-plan-cn.xiaomimimo.com/v1
LLM_API_KEY=replace-with-your-mimo-key
LLM_CHAT_MODEL=mimo-v2.5-pro
AI_PROVIDER=openai-compatible
EMBEDDING_PROVIDER=mock
RAG_MODE=memory
RAG_FULL_CONTEXT=true
RAG_MAX_CONTEXT_CHARS=6000
VITE_DEMO_REPO_PATH=/app/demo-repos/mall-order-service

# ---- 可观测性(可选,留默认即安全落地)----
# Alertmanager 告警外发 webhook;留空 = 空接收器,告警只在 127.0.0.1:9093 的 UI
# 可见不外发。钉钉机器人不认原生载荷,需经桥接,见 deploy/observability/README.md。
ALERT_WEBHOOK_URL=
# Grafana 管理员初始密码（必须替换为强随机值；服务仅绑定 127.0.0.1）
GRAFANA_ADMIN_PASSWORD=change-me-to-a-strong-grafana-password
