{
  "uid": "reposage-overview",
  "title": "RepoSage 运行概览",
  "description": "单机演示栈的一张总览看板:HTTP 流量与时延、MQ 队列深度与死信、AI 调用与熔断、JVM 内存、抓取目标存活。指标全部来自既有暴露面(backend /actuator/prometheus 与 rabbitmq_prometheus per-object 端点),看板不要求任何 backend 配置改动。注意:http.server.requests 未开直方图桶(backend 仅对 reposage.agent.step/tool 开了 percentiles-histogram),故 HTTP 时延面板用均值+瞬时最大而非 p95;真 p95 见 Agent 步进面板。",
  "tags": ["reposage"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "graphTooltip": 1,
  "refresh": "30s",
  "time": { "from": "now-1h", "to": "now" },
  "annotations": { "list": [] },
  "templating": { "list": [] },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "HTTP 请求速率(按状态码)",
      "description": "backend http.server.requests 计数器的 5 分钟速率,按状态码分列;4xx/5xx 抬升即入口异常。",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": { "fillOpacity": 10, "showPoints": "never" }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (status) (rate(http_server_requests_seconds_count[5m]))",
          "legendFormat": "HTTP {{status}}"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "HTTP 时延(均值 / 瞬时最大)",
      "description": "均值 = sum 速率 / count 速率;最大值取自 micrometer 的 _max 序列。不是 p95:backend 未对 http.server.requests 开直方图桶,开桶属 backend 配置改动,不在本批范围。",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": { "fillOpacity": 10, "showPoints": "never" }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(http_server_requests_seconds_sum[5m])) / sum(rate(http_server_requests_seconds_count[5m]))",
          "legendFormat": "均值"
        },
        {
          "refId": "B",
          "expr": "max(http_server_requests_seconds_max)",
          "legendFormat": "瞬时最大"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "工作队列深度(就绪消息)",
      "description": "三条主工作队列 + 延迟/取消队列的就绪消息数(rabbitmq_prometheus per-object 端点)。delay 队列有存量属正常(TTL 等待中);task/step/job 队列持续增长即消费端跟不上,对应告警 ReviewQueueBacklog。",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": { "fillOpacity": 10, "showPoints": "never" }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "rabbitmq_queue_messages_ready{queue=~\"code.review.task.queue|code.review.delay.queue|agent.step.queue|agent.delay.queue|agent.cancel.queue|sandbox.job.queue\"}",
          "legendFormat": "{{queue}}"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "死信队列消息数(应恒为 0)",
      "description": "code.review.dead.queue / agent.dead.queue / sandbox.dead.queue 的消息总数(ready+unacked)。任何非零都代表有任务耗尽重试彻底失败,对应告警 DeadLetterQueueNotEmpty;排查见 docs/04_MQ与异步任务设计.md。",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "custom": { "fillOpacity": 20, "showPoints": "never" },
          "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "red", "value": 1 } ] }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "rabbitmq_queue_messages{queue=~\"code.review.dead.queue|agent.dead.queue|sandbox.dead.queue\"}",
          "legendFormat": "{{queue}}"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "AI 调用速率(成功 / 失败)",
      "description": "backend 自定义计时器 reposage.ai.review(标签 provider/model/status)的调用速率;failure 抬升先看熔断面板与大模型服务可用性。",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 16 },
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "custom": { "fillOpacity": 10, "showPoints": "never" }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (status) (rate(reposage_ai_review_seconds_count[5m]))",
          "legendFormat": "{{status}}"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "AI 熔断器状态(aiReview)",
      "description": "resilience4j_circuitbreaker_state 按 state 标签展开,处于哪个状态哪条为 1。open=1 时 AI 调用被快速失败,对应告警 AiCircuitBreakerOpen;开态窗口 30s 后自动转 half_open 试探。",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 16 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "max": 1,
          "custom": { "fillOpacity": 20, "showPoints": "never", "stacking": { "mode": "none" } }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max by (state) (resilience4j_circuitbreaker_state{name=\"aiReview\"})",
          "legendFormat": "{{state}}"
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "AI Token 消耗速率",
      "description": "backend 计数器 reposage.ai.tokens 按 type(prompt/completion/total)分列的每秒消耗;成本核对以数据库 ai_call_log 为准,这里是趋势视图。",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 16 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": { "fillOpacity": 10, "showPoints": "never" }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (type) (rate(reposage_ai_tokens_total[5m]))",
          "legendFormat": "{{type}}"
        }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Agent 步进时延 p95",
      "description": "reposage.agent.step 是 backend 少数开了 percentiles-histogram 的计时器,这里是真 histogram_quantile p95(与 HTTP 面板的均值口径不同)。",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 24 },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": { "fillOpacity": 10, "showPoints": "never" }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(reposage_agent_step_seconds_bucket[5m])))",
          "legendFormat": "步进 p95"
        }
      ]
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "JVM 堆内存(backend)",
      "description": "used 贴近 committed 且频繁 GC 即内存吃紧;backend 容器 mem_limit 1200m、JVM MaxRAMPercentage 60%。",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 24 },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "custom": { "fillOpacity": 10, "showPoints": "never" }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(jvm_memory_used_bytes{area=\"heap\"})",
          "legendFormat": "已用"
        },
        {
          "refId": "B",
          "expr": "sum(jvm_memory_committed_bytes{area=\"heap\"})",
          "legendFormat": "已提交"
        }
      ]
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "抓取目标存活(up)",
      "description": "backend / otel-collector / rabbitmq 三个抓取目标的存活状态;掉 0 持续 2 分钟触发告警 InstanceDown。",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 24 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "max": 1,
          "custom": { "fillOpacity": 20, "showPoints": "never" }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "up",
          "legendFormat": "{{job}}"
        }
      ]
    }
  ]
}
