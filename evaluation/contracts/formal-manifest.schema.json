{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "forgepilot-formal-evaluation-manifest-v1",
  "title": "ForgePilot normalized 26+12 formal corpus",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "corpusVersion", "source", "cases"],
  "properties": {
    "schemaVersion": { "const": "forgepilot-evaluation-manifest-v1" },
    "corpusVersion": { "type": "string", "minLength": 1 },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "commit", "migrationPolicy"],
      "properties": {
        "repository": { "const": "https://github.com/LinYsssss/reposage" },
        "commit": { "const": "96137dd3b43e14c5e8881c99688663afd979cf4e" },
        "migrationPolicy": { "const": "REWRITE_KEEP_DATA" }
      }
    },
    "cases": {
      "type": "array",
      "minItems": 38,
      "maxItems": 38,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id", "split", "language", "fixture", "fixtureLayout", "selectionReason",
          "requirement", "acceptanceCriteria", "expectedAcVerdicts", "expectedFindings", "nonFindings"
        ],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
          "split": { "enum": ["development", "holdout"] },
          "language": { "enum": ["JAVA", "TYPESCRIPT", "PYTHON"] },
          "fixture": { "type": "string", "pattern": "^cases/[a-z0-9-]+$" },
          "fixtureLayout": { "enum": ["single", "base-head"] },
          "selectionReason": { "type": "string", "minLength": 1 },
          "requirement": {
            "type": "object",
            "additionalProperties": false,
            "required": ["title", "background", "description"],
            "properties": {
              "title": { "type": "string", "minLength": 1 },
              "background": { "type": "string", "minLength": 1 },
              "description": { "type": "string", "minLength": 1 }
            }
          },
          "acceptanceCriteria": {
            "type": "array",
            "minItems": 1,
            "items": { "$ref": "manifest.schema.json#/$defs/acceptanceCriterion" }
          },
          "expectedAcVerdicts": {
            "type": "array",
            "minItems": 1,
            "items": { "$ref": "manifest.schema.json#/$defs/acTruth" }
          },
          "expectedFindings": {
            "type": "array",
            "items": { "$ref": "manifest.schema.json#/$defs/finding" }
          },
          "nonFindings": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          }
        }
      }
    }
  },
  "$comment": "The standard-library validator additionally enforces exactly 26 development and 12 holdout cases."
}
