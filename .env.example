# Copy to .env for local use. These values are Phase 1-only examples, not
# production credentials or deployment defaults.
COMPOSE_PROJECT_NAME=forgepilot-phase1-local

# Published application ports remain loopback-only unless deliberately changed.
FORGEPILOT_BIND_ADDRESS=127.0.0.1
FORGEPILOT_BACKEND_PORT=18080
FORGEPILOT_FRONTEND_PORT=18081

# Replace the example password before using the stack outside an isolated host.
FORGEPILOT_DB_NAME=forgepilot
FORGEPILOT_DB_USERNAME=forgepilot
FORGEPILOT_DB_PASSWORD=replace-with-a-local-secret
FORGEPILOT_DB_POOL_SIZE=5

# Frozen Phase 1 empty-stack memory envelope. Any capacity-tuning change needs
# a new complete capacity run.
FORGEPILOT_JAVA_TOOL_OPTIONS=-Xms128m -Xmx384m -XX:MaxDirectMemorySize=128m -XX:MaxMetaspaceSize=128m -XX:+UseSerialGC -XX:NativeMemoryTracking=summary
