# Copy to .env for local use. These are examples for a local or CI stack, never
# production credentials or deployment defaults.
COMPOSE_PROJECT_NAME=forgepilot-local

# Published application ports remain loopback-only unless deliberately changed.
FORGEPILOT_BIND_ADDRESS=127.0.0.1
FORGEPILOT_BACKEND_PORT=18080
FORGEPILOT_FRONTEND_PORT=18081

# Replace the example password before using the stack outside an isolated host.
FORGEPILOT_DB_NAME=forgepilot
FORGEPILOT_DB_USERNAME=forgepilot
FORGEPILOT_DB_PASSWORD=replace-with-a-local-secret
FORGEPILOT_DB_POOL_SIZE=5

# Encrypts every SCM token and webhook secret this deployment stores. The
# application declares it with no fallback, so a missing value stops startup
# rather than silently encrypting with a weak default -- but compose.yaml carries
# a local-only default, which is a published string in this repository. Replace it
# before storing any real credential, or every one of them is protected by a key
# anybody can read.
FORGEPILOT_SCM_SECRET_KEY=replace-with-a-high-entropy-secret

# Chat and embedding may be served by different OpenAI-compatible providers.
# Never commit real credentials; keep them only in the deployment's .env.
FORGEPILOT_AI_BASE_URL=
FORGEPILOT_AI_API_KEY=
FORGEPILOT_AI_CHAT_MODEL=
FORGEPILOT_EMBEDDING_BASE_URL=
FORGEPILOT_EMBEDDING_API_KEY=
FORGEPILOT_KNOWLEDGE_EMBEDDING_PROVIDER=
FORGEPILOT_KNOWLEDGE_EMBEDDING_MODEL=
FORGEPILOT_KNOWLEDGE_EMBEDDING_VERSION=
# Frozen by the Phase 6 maximum-budget capacity run; constrained hosts may use 1.
FORGEPILOT_REVIEW_CONCURRENCY=2

# Application-layer rate limits, counted per client address (resolved from the
# forwarded header nginx sets). Defence in depth only -- real traffic shaping
# belongs on the proxy. Leave these alone unless a deployment shows them too tight;
# for webhooks too low is worse than absent, since neither provider retries and a
# throttled delivery is a lost one. There is no "off" value: 0 fails startup.
FORGEPILOT_LOGIN_ATTEMPTS_PER_MINUTE=20
FORGEPILOT_REGISTRATIONS_PER_TEN_MINUTES=5
FORGEPILOT_WEBHOOK_DELIVERIES_PER_MINUTE=60

# Frozen empty-stack memory envelope measured in Phase 1 on the 4 GB target host.
# Any capacity-tuning change needs a new complete capacity run.
FORGEPILOT_JAVA_TOOL_OPTIONS=-Xms128m -Xmx384m -XX:MaxDirectMemorySize=128m -XX:MaxMetaspaceSize=128m -XX:+UseSerialGC -XX:NativeMemoryTracking=summary
